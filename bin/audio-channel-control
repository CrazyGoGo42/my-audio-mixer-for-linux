#!/bin/bash
# Audio channel control — mute / volume up / volume down per virtual sink.
# Usage: audio-channel-control <channel> <action>
#   channel: games | discord | music | browser | default
#   action:  mute | up | down
#
# Volume is applied directly to the virtual sink. Because every app plays
# through one of these sinks, each channel's level is fully independent of the
# others and of the hardware slider. The intended % is cached in a state file
# so it survives the sink suspending/resuming.

STEP=1
FIFO="/tmp/audio-osd.fifo"
STATE="/tmp/audio-mixer-volumes"

case "$1" in
    games)   SINK="Games_Audio";   L="Games"   ;;
    discord) SINK="Discord_Audio"; L="Discord" ;;
    music)   SINK="Music_Audio";   L="Music"   ;;
    browser) SINK="Browser_Audio"; L="Browser" ;;
    default) SINK="Default_Audio"; L="Default" ;;
    *) exit 1 ;;
esac

# Auto-start OSD daemon if its pipe is missing.
[ ! -p "$FIFO" ] && { nohup "$HOME/.local/bin/audio-osd" >/dev/null 2>&1 & sleep 0.3; }

# Current intended volume (default 100).
VOL=$(grep "^${SINK}=" "$STATE" 2>/dev/null | tail -1 | cut -d= -f2)
[ -z "$VOL" ] && VOL=100

write_state() {
    if grep -q "^${SINK}=" "$STATE" 2>/dev/null; then
        sed -i "s/^${SINK}=.*/${SINK}=${VOL}/" "$STATE"
    else
        echo "${SINK}=${VOL}" >> "$STATE"
    fi
}

case "$2" in
    mute)
        pactl set-sink-mute "$SINK" toggle
        if pactl get-sink-mute "$SINK" | grep -q yes; then
            echo "$L muted" > "$FIFO" &
        else
            echo "$L ${VOL}%" > "$FIFO" &
        fi
        ;;
    down)
        pactl set-sink-mute "$SINK" 0
        VOL=$((VOL - STEP)); [ "$VOL" -lt 0 ] && VOL=0
        write_state
        pactl set-sink-volume "$SINK" "${VOL}%" 2>/dev/null
        echo "$L ${VOL}%" > "$FIFO" &
        ;;
    up)
        pactl set-sink-mute "$SINK" 0
        VOL=$((VOL + STEP)); [ "$VOL" -gt 100 ] && VOL=100
        write_state
        pactl set-sink-volume "$SINK" "${VOL}%" 2>/dev/null
        echo "$L ${VOL}%" > "$FIFO" &
        ;;
esac
true
