#!/bin/bash
# Audio channel control — mute / volume up / volume down per virtual sink.
# Usage: audio-channel-control <channel> <action>
#   channel: a key from ~/.config/audio-mixer/channels.conf (games, discord, ...)
#   action:  mute | up | down
#
# Volume is applied directly to the virtual sink. Because every app plays
# through one of these sinks, each channel's level is fully independent of the
# others and of the hardware slider. The current level is always read from the
# sink itself, so a change made anywhere else (pavucontrol, GNOME Settings) is
# where the next keypress continues from.

STEP=1
FIFO="/tmp/audio-osd.fifo"
CHANNELS="$HOME/.config/audio-mixer/channels.conf"

# channel key -> sink name + label (label is the rest of the line after 5 columns)
read -r SINK L < <(awk -v k="$1" '{ sub(/#.*/, "") }
    NF >= 6 && $1 == k { l = $6; for (i = 7; i <= NF; i++) l = l " " $i; print $2, l; exit }' \
    "$CHANNELS" 2>/dev/null)
[ -z "$SINK" ] && exit 1

# Auto-start OSD daemon if its pipe is missing.
[ ! -p "$FIFO" ] && { nohup "$HOME/.local/bin/audio-osd" >/dev/null 2>&1 & sleep 0.3; }

VOL=$(pactl get-sink-volume "$SINK" 2>/dev/null | grep -oP '/\s*\K[0-9]+(?=%)' | head -1)
[ -z "$VOL" ] && exit 1   # channel sink not up (PipeWire restarting) — touch nothing

case "$2" in
    mute)
        pactl set-sink-mute "$SINK" toggle
        if pactl get-sink-mute "$SINK" | grep -q yes; then
            echo "$L muted" > "$FIFO" &
        else
            echo "$L ${VOL}%" > "$FIFO" &
        fi
        ;;
    down)
        pactl set-sink-mute "$SINK" 0
        VOL=$((VOL - STEP)); [ "$VOL" -lt 0 ] && VOL=0
        pactl set-sink-volume "$SINK" "${VOL}%" 2>/dev/null
        echo "$L ${VOL}%" > "$FIFO" &
        ;;
    up)
        pactl set-sink-mute "$SINK" 0
        VOL=$((VOL + STEP)); [ "$VOL" -gt 100 ] && VOL=100
        pactl set-sink-volume "$SINK" "${VOL}%" 2>/dev/null
        echo "$L ${VOL}%" > "$FIFO" &
        ;;
esac
true
