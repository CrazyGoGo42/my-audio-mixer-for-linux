#!/usr/bin/env python3
"""
audio-mixer — control the mixer from the command line (the window uses it too).

    audio-mixer status [--json]                 what goes where right now
    audio-mixer devices [--json]                real outputs and mics you can pick
    audio-mixer fx <channel> on|off|toggle      through EasyEffects, or dry
    audio-mixer out <channel|fx> <A1-A4> on|off|toggle
                                                which output slots a channel (or
                                                the EasyEffects strip, "fx") plays on
    audio-mixer slot <A1-A4> <device>|default|none
                                                which device a slot is
    audio-mixer eq <channel> bass|treble <dB>   -12 … +12, 0 = flat
    audio-mixer mic auto|<device>               which real mic feeds EasyEffects
    audio-mixer hotkeys list|apply              your hotkeys (~/.config/audio-mixer/hotkeys.json)
    audio-mixer hotkeys set <action> <keys>     e.g. set mic:mute "<Ctrl><Alt>m"
    audio-mixer hotkeys clear <action>
    audio-mixer restart easyeffects             quit EasyEffects and start it again
    audio-mixer restart engine                  restart PipeWire safely (EasyEffects
                                                and the router daemon come back too)

<channel> is a key or label from channels.conf (e.g. desktop, discord, music).
Changes are saved to ~/.config/audio-mixer/mixer.json and take effect at once;
the router daemon keeps them wired from then on. A channel's slots only matter
while its FX is off — with FX on it plays where the EasyEffects strip plays.
"""

import json
import os
import sys

# The shared audiomixer package: lib/ next to bin/ in the repo, or installed.
for _lib in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
             os.path.expanduser("~/.local/lib/audio-mixer")):
    if os.path.isdir(os.path.join(_lib, "audiomixer")):
        sys.path.insert(0, _lib)
        break
from audiomixer import easyeffects, hotkeys  # noqa: E402
from audiomixer.commands import devices_list, out_message, run, status_dict  # noqa: E402
from audiomixer.config import AUTO_MIC, DEFAULT_OUTPUT, SLOTS, load_channels, load_state  # noqa: E402
from audiomixer.pwgraph import read_graph  # noqa: E402


def _print_status(st):
    def slot_text(slot):
        info = st["slots"][slot]
        if info["value"] is None:
            return f"{slot} off"
        where = "default output" if info["value"] == DEFAULT_OUTPUT else info["value"]
        return f"{slot} {where} ({info['description'] or 'not connected'})"

    print("Outputs:     " + "\n             ".join(slot_text(s) for s in SLOTS))
    for c in st["channels"]:
        dest = "EasyEffects" if c["fx"] else (", ".join(c["outputs"]) or "nowhere")
        print(f"{c['label']:12s} FX {'on ' if c['fx'] else 'off'}  -> {dest:20s}"
              f" bass {c['bass']:+5.1f}  treble {c['treble']:+5.1f}")
    print(f"{'EasyEffects':12s}         -> {', '.join(st['fx_outputs']) or 'nowhere'}")
    mic = st["mic"]
    print(f"{'Mic':12s} {'auto' if mic['value'] == AUTO_MIC else 'pinned'} -> {mic['device'] or 'none present'}")


def restart(what):
    """The window's settings menu runs these (they take a few seconds)."""
    if what == ["engine"]:
        # The one safe way: all three PipeWire services together, EasyEffects
        # quit first and relaunched, volumes restored before anything plays.
        tool = os.path.join(os.path.dirname(os.path.realpath(__file__)), "audio-routes-apply")
        os.execv(tool, [tool, "--restart-pipewire"])
    if what == ["easyeffects"]:
        easyeffects.stop()
        easyeffects.launch()
        return 0
    print("usage: audio-mixer restart easyeffects|engine", file=sys.stderr)
    return 2


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "restart":
        return restart(argv[1:])
    channels = load_channels()
    if argv[0] == "hotkeys":
        code, text = hotkeys.cli(argv[1:], channels, os.path.expanduser("~/.local/bin"))
        if text:
            print(text, file=sys.stderr if code else sys.stdout)
        return code
    if argv[0] in ("status", "devices"):
        graph = read_graph()
        data = (status_dict(channels, load_state(channels), graph) if argv[0] == "status"
                else devices_list(channels, graph))
        if "--json" in argv:
            print(json.dumps(data, indent=2))
        elif argv[0] == "status":
            _print_status(data)
        else:
            for d in data:
                print(f"{d['kind']:7s} {d['name']}  ({d['description']})")
        return 0
    try:
        state = run(argv)
        if argv[0] == "out":
            print(out_message(argv, channels, state))
    except ValueError as e:
        print(f"audio-mixer: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
