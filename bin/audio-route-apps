#!/usr/bin/env python3
"""
Move every currently-playing app onto its configured channel, right now.

Routing is normally declarative (apps are born on the right sink at login).
Use this after editing routes.json, or to fix up streams that were already
playing, without logging out. Unknown apps are left on the Default channel.
"""

import json
import os
import subprocess

ROUTES_FILE = os.path.expanduser("~/.config/audio-mixer/routes.json")
DEFAULT_SINK = "Default_Audio"
VIRTUAL_SINKS = {
    "Games_Audio", "Discord_Audio", "Music_Audio", "Browser_Audio", "Default_Audio",
}
VIRTUAL_OUTPUTS = {s + "_out" for s in VIRTUAL_SINKS}


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def load_routes():
    try:
        with open(ROUTES_FILE) as f:
            return json.load(f)
    except Exception:
        return {"binary": {}, "app": {}}


def target_for(binary, app, routes):
    if binary and binary in routes.get("binary", {}):
        return routes["binary"][binary]
    if app and app in routes.get("app", {}):
        return routes["app"][app]
    return DEFAULT_SINK


def sink_names():
    names = {}
    for line in run(["pactl", "list", "sinks", "short"]).splitlines():
        p = line.split()
        if len(p) >= 2:
            names[p[0]] = p[1]
    return names


def main():
    routes = load_routes()
    names = sink_names()
    out = run(["pactl", "list", "sink-inputs"])
    cur = None
    streams = []
    for raw in out.splitlines():
        s = raw.strip()
        if s.startswith("Sink Input #"):
            if cur:
                streams.append(cur)
            cur = {"idx": s.split("#")[1], "sink": None, "props": {}}
        elif s.startswith("Sink:") and cur:
            cur["sink"] = s.split(":")[1].strip()
        elif "=" in s and cur:
            k, _, v = s.partition("=")
            cur["props"][k.strip()] = v.strip().strip('"')
    if cur:
        streams.append(cur)

    moved = 0
    for st in streams:
        node = st["props"].get("node.name", "")
        if node in VIRTUAL_OUTPUTS:
            continue
        binary = st["props"].get("application.process.binary", "")
        app = st["props"].get("application.name", "")
        if not (binary or app):
            continue
        target = target_for(binary, app, routes)
        if names.get(st["sink"]) == target:
            continue
        r = subprocess.run(["pactl", "move-sink-input", st["idx"], target],
                           capture_output=True, text=True)
        if r.returncode == 0:
            print(f"  {app or binary} → {target.replace('_Audio', '')}")
            moved += 1

    print(f"Moved {moved} stream(s)." if moved else "Everything already on its channel.")


if __name__ == "__main__":
    main()
