#!/usr/bin/env python3
"""
Audio Router Daemon — slim companion to the declarative routing config.

Routing itself is handled declaratively by pipewire-pulse (see
audio-routes-apply): every app is born on the correct virtual sink, so this
daemon does NOT chase streams around or fight WirePlumber like the old one did.

It does exactly two things:

  1. When a genuinely new app (one not in routes.json) starts playing, it lands
     on the Default channel — attenuated and safe — and this daemon pops a small
     dialog asking which channel it should use from now on. The choice is saved
     to routes.json and compiled into the routing config for next login.

  2. Keeps the channel → EasyEffects → hardware chain wired if EasyEffects
     restarts and recreates its sink.

No notifications. No volume juggling (audio-channel-control sets channel volume
directly). Singleton: a new instance replaces the old one.
"""

import json
import os
import signal
import subprocess
import sys
import threading
import time

CHAIN_POLL_SECONDS = 3

PID_FILE = "/tmp/audio-router-daemon.pid"
ROUTES_FILE = os.path.expanduser("~/.config/audio-mixer/routes.json")
APPLY_CMD = os.path.expanduser("~/.local/bin/audio-routes-apply")

DEFAULT_SINK = "Default_Audio"
VIRTUAL_SINKS = {
    "Games_Audio", "Discord_Audio", "Music_Audio", "Browser_Audio", "Default_Audio",
}
VIRTUAL_OUTPUTS = {s + "_out" for s in VIRTUAL_SINKS}
CHANNELS = [
    ("Games_Audio", "Games"),
    ("Discord_Audio", "Discord"),
    ("Music_Audio", "Music"),
    ("Browser_Audio", "Browser"),
]

# Streams we never ask about (our own plumbing / system noise).
IGNORE_APPS = {
    "audio-osd", "speech-dispatcher-dummy", "libcanberra",
    "GNOME Volume Control Media Keys", "gnome-shell", "Mutter",
    "easyeffects", "xdg-desktop-portal", "gnome-control-center",
}

# Apps asked about this session (avoid repeat dialogs within one login).
asked_this_session = set()


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""


# --------------------------------------------------------------------------- #
# routes.json
# --------------------------------------------------------------------------- #

def load_routes():
    try:
        with open(ROUTES_FILE) as f:
            data = json.load(f)
    except Exception:
        data = {}
    data.setdefault("binary", {})
    data.setdefault("app", {})
    data.setdefault("ignore", [])
    return data


def save_routes(data):
    os.makedirs(os.path.dirname(ROUTES_FILE), exist_ok=True)
    tmp = ROUTES_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, ROUTES_FILE)


def is_known(routes, binary, app):
    if binary and binary in routes["binary"]:
        return True
    if app and app in routes["app"]:
        return True
    if (binary and binary in routes["ignore"]) or (app and app in routes["ignore"]):
        return True
    return False


# --------------------------------------------------------------------------- #
# Stream inspection
# --------------------------------------------------------------------------- #

def sink_index_to_name():
    names = {}
    for line in run(["pactl", "list", "sinks", "short"]).splitlines():
        parts = line.split()
        if len(parts) >= 2:
            names[parts[0]] = parts[1]
    return names


def list_streams():
    """Return [{idx, app, binary, node, sink_name}] for current sink-inputs."""
    names = sink_index_to_name()
    out = run(["pactl", "list", "sink-inputs"])
    streams = []
    cur = None
    for raw in out.splitlines():
        s = raw.strip()
        if s.startswith("Sink Input #"):
            if cur:
                streams.append(cur)
            cur = {"idx": s.split("#")[1], "sink": None, "props": {}}
        elif s.startswith("Sink:") and cur:
            cur["sink"] = s.split(":")[1].strip()
        elif "=" in s and cur:
            k, _, v = s.partition("=")
            cur["props"][k.strip()] = v.strip().strip('"')
    if cur:
        streams.append(cur)

    result = []
    for st in streams:
        result.append({
            "idx": st["idx"],
            "app": st["props"].get("application.name", ""),
            "binary": st["props"].get("application.process.binary", ""),
            "node": st["props"].get("node.name", ""),
            "sink_name": names.get(st["sink"], ""),
        })
    return result


def identity_key(stream):
    """Best routes.json key + field for this stream (binary preferred)."""
    if stream["binary"]:
        return "binary", stream["binary"]
    if stream["app"]:
        return "app", stream["app"]
    if stream["node"]:
        return "app", stream["node"]
    return None, None


# --------------------------------------------------------------------------- #
# Dialog + assignment
# --------------------------------------------------------------------------- #

def ask_channel(display):
    rows = []
    for sink, label in CHANNELS:
        rows += [sink, label]
    rows += ["__ignore__", "Leave on Default (stop asking)"]
    try:
        r = subprocess.run(
            ["zenity", "--list", "--title", f"Route: {display}",
             "--text", f"<b>{display}</b> started playing.\nWhich channel should it use?",
             "--column", "sink", "--column", "Channel", "--hide-column=1",
             *rows, "--width", "360", "--height", "320"],
            capture_output=True, text=True, timeout=120,
        )
    except Exception:
        return None
    if r.returncode != 0:
        return None
    choice = r.stdout.strip().rstrip("|")
    return choice or None


def assign(stream, choice):
    """Persist the choice and make it take effect now (no audio blip)."""
    field, key = identity_key(stream)
    if not key:
        return
    routes = load_routes()
    if choice == "__ignore__":
        if key not in routes["ignore"]:
            routes["ignore"].append(key)
        save_routes(routes)
        return

    routes[field][key] = choice
    save_routes(routes)
    # Move the live stream right now for instant feedback (it's currently on the
    # attenuated Default channel, so this is never a loud jump).
    subprocess.run(["pactl", "move-sink-input", stream["idx"], choice],
                   capture_output=True, text=True)
    # Recompile the config (no pulse restart) so the rule is permanent at next login.
    subprocess.run([APPLY_CMD, "--no-restart"], capture_output=True, text=True)


# --------------------------------------------------------------------------- #
# EasyEffects chain safety
# --------------------------------------------------------------------------- #

def downstream_target():
    sinks = run(["pactl", "list", "sinks", "short"])
    if "easyeffects_sink" in sinks:
        return "easyeffects_sink"
    for line in sinks.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1].startswith("alsa_output") and "hdmi" not in parts[1].lower():
            return parts[1]
    return None


def fix_chain():
    """Ensure each virtual sink's output feeds the downstream (EasyEffects) sink."""
    target = downstream_target()
    if not target:
        return
    names = sink_index_to_name()
    out = run(["pactl", "list", "sink-inputs"])
    idx = node = sink = None
    for raw in out.splitlines():
        s = raw.strip()
        if s.startswith("Sink Input #"):
            idx, node, sink = s.split("#")[1], None, None
        elif s.startswith("Sink:"):
            sink = s.split(":")[1].strip()
        elif "node.name" in s and "=" in s:
            node = s.split("=")[1].strip().strip('"')
            if node in VIRTUAL_OUTPUTS and sink and names.get(sink) != target:
                subprocess.run(["pactl", "move-sink-input", idx, target],
                               capture_output=True, text=True)


# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

def kill_previous():
    try:
        with open(PID_FILE) as f:
            old = int(f.read().strip())
        if old != os.getpid():
            os.kill(old, signal.SIGTERM)
            time.sleep(0.3)
    except Exception:
        pass


def cleanup(*_):
    try:
        os.unlink(PID_FILE)
    except OSError:
        pass
    sys.exit(0)


def consider(stream, routes):
    binary, app = stream["binary"], stream["app"]
    if stream["node"] in VIRTUAL_OUTPUTS:
        return
    if app in IGNORE_APPS or binary in IGNORE_APPS:
        return
    display = app or binary or stream["node"]
    if not display or display.startswith("PipeWire"):
        return
    if is_known(routes, binary, app):
        return
    if app in asked_this_session or binary in asked_this_session:
        return
    asked_this_session.add(app or binary)
    asked_this_session.add(binary or app)
    choice = ask_channel(display)
    if choice:
        assign(stream, choice)


def main():
    kill_previous()
    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    time.sleep(2)  # let PipeWire settle on login

    # Keep the channel -> EasyEffects chain wired even when EasyEffects starts
    # late or restarts. fix_chain() is idempotent (it only moves a link that has
    # drifted), so polling it is quiet and self-healing, and it sidesteps the
    # timing races of reacting to individual graph events.
    def chain_watch():
        while True:
            time.sleep(CHAIN_POLL_SECONDS)
            try:
                fix_chain()
            except Exception:
                pass
    threading.Thread(target=chain_watch, daemon=True).start()

    # Outer loop keeps us alive across pipewire-pulse restarts: `pactl subscribe`
    # ends when pulse restarts, so we re-settle, re-wire the chain, rescan, and
    # resubscribe instead of dying.
    while True:
        fix_chain()
        routes = load_routes()
        for stream in list_streams():
            consider(stream, routes)

        proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
        for line in proc.stdout:
            if "'new'" in line and "sink-input" in line:
                time.sleep(0.3)  # let props populate; stream is already safe on Default
                # A channel's _out node links to the default sink when it first
                # activates; pull it back onto the EasyEffects chain.
                fix_chain()
                routes = load_routes()
                for stream in list_streams():
                    consider(stream, routes)
            elif ("'new'" in line or "'remove'" in line) and "sink" in line and "sink-input" not in line:
                time.sleep(0.5)
                fix_chain()

        # Subscription ended — pulse restarted or crashed. Reconnect after a beat.
        try:
            proc.wait(timeout=2)
        except Exception:
            pass
        time.sleep(1.5)


if __name__ == "__main__":
    main()
