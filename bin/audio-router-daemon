#!/usr/bin/env python3
"""
Audio Router Daemon — slim companion to the declarative routing config.

Routing itself is handled declaratively by pipewire-pulse (see
audio-routes-apply): every app is born on the correct virtual sink, so this
daemon does NOT chase streams around or fight WirePlumber like the old one did.

It does exactly two things:

  1. When a genuinely new app (one not in routes.json) starts playing, it lands
     on the Default channel — attenuated and safe — and this daemon pops a small
     dialog asking which channel it should use from now on. The choice is saved
     to routes.json and compiled into the routing config for next login.

  2. Is the mixer's patchbay. The mixer's own nodes (channel outputs, the
     EasyEffects strip, Mic_In, All Audio) are never linked by WirePlumber;
     every few seconds, and on every graph change, this daemon links them as
     ~/.config/audio-mixer/mixer.json says (FX on/off, A1–A4, which mic) and
     re-applies each channel's Bass/Treble after PipeWire restarts.

  3. Remembers each channel's volume across reboots. WirePlumber saves these
     loopback-sink volumes but does NOT reliably re-apply them at login (the
     channels come up at 100%), so we snapshot them while you use them and
     re-apply the saved levels once at login. This restores once at startup; it
     does not fight volume changes you make during the session.

No notifications. Singleton: a new instance replaces the old one.
"""

import glob
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

# A safety net: real changes (devices, EasyEffects restarting, apps) trigger a
# pass at once through `pactl subscribe`, so a slow poll is enough.
CHAIN_POLL_SECONDS = 10

# The shared audiomixer package: lib/ next to bin/ in the repo, or installed.
for _lib in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
             os.path.expanduser("~/.local/lib/audio-mixer")):
    if os.path.isdir(os.path.join(_lib, "audiomixer")):
        sys.path.insert(0, _lib)
        break
from audiomixer.config import (  # noqa: E402
    ALL_AUDIO, EE_RETURN, MIC_IN, STATE_FILE, load_channels, load_state,
)
from audiomixer import apps, hotkeys  # noqa: E402
from audiomixer.pwgraph import read_graph  # noqa: E402
from audiomixer.reconcile import apply_eq, reconcile_once  # noqa: E402
from audiomixer.routing import own_nodes  # noqa: E402

PID_FILE = "/tmp/audio-router-daemon.pid"
VOL_FILE = os.path.expanduser("~/.config/audio-mixer/volumes.json")

# Node ids of the volume targets as last seen, and how many more passes should
# restore (not save) volumes. Nodes (re)created at login or by a PipeWire
# restart come up at 100%; saving then would overwrite the user's levels.
vol_ids_seen = {}   # node name -> node id whose saved volume was re-applied
restores_left = {}  # node name -> restore passes still due


# Read once at startup; audio-routes-apply restarts us when the list changes.
try:
    CHANNEL_LIST = load_channels()
except OSError:
    CHANNEL_LIST = []
DEFAULT_SINK = next((c.sink for c in CHANNEL_LIST if c.key == "default"), "Default_Audio")
VIRTUAL_SINKS = {c.sink for c in CHANNEL_LIST}
OWN = own_nodes(CHANNEL_LIST)
# Choices offered by the popup — every channel except the catch-all.
CHANNELS = [(c.sink, c.label) for c in CHANNEL_LIST if c.key != "default"]

# Apps asked about this session (avoid repeat dialogs within one login).
asked_this_session = set()


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""


# --------------------------------------------------------------------------- #
# Stream inspection
# --------------------------------------------------------------------------- #

def sink_index_to_name():
    names = {}
    for line in run(["pactl", "list", "sinks", "short"]).splitlines():
        parts = line.split()
        if len(parts) >= 2:
            names[parts[0]] = parts[1]
    return names


def list_streams():
    """Return [{idx, app, binary, node, sink_name}] for current sink-inputs."""
    names = sink_index_to_name()
    out = run(["pactl", "list", "sink-inputs"])
    streams = []
    cur = None
    for raw in out.splitlines():
        s = raw.strip()
        if s.startswith("Sink Input #"):
            if cur:
                streams.append(cur)
            cur = {"idx": s.split("#")[1], "sink": None, "props": {}}
        elif s.startswith("Sink:") and cur:
            cur["sink"] = s.split(":")[1].strip()
        elif "=" in s and cur:
            k, _, v = s.partition("=")
            cur["props"][k.strip()] = v.strip().strip('"')
    if cur:
        streams.append(cur)

    result = []
    for st in streams:
        result.append({
            "idx": st["idx"],
            "app": st["props"].get("application.name", ""),
            "binary": st["props"].get("application.process.binary", ""),
            "node": st["props"].get("node.name", ""),
            "sink_name": names.get(st["sink"], ""),
        })
    return result


# --------------------------------------------------------------------------- #
# Dialog + assignment
# --------------------------------------------------------------------------- #

def ensure_display():
    """zenity is a GTK app and needs an X display. When systemd starts this
    daemon early at login, DISPLAY/XAUTHORITY aren't in its environment yet (the
    graphical session exports them a moment later), and a process can't inherit
    them after the fact. Discover them ourselves so the routing prompt can draw
    regardless of startup ordering."""
    if not os.environ.get("DISPLAY"):
        socks = sorted(glob.glob("/tmp/.X11-unix/X*"))
        if socks:
            os.environ["DISPLAY"] = ":" + os.path.basename(socks[0])[1:]
    if not os.environ.get("XAUTHORITY"):
        for cand in (f"/run/user/{os.getuid()}/gdm/Xauthority",
                     os.path.expanduser("~/.Xauthority")):
            if os.path.exists(cand):
                os.environ["XAUTHORITY"] = cand
                break


def ask_channel(display):
    ensure_display()
    rows = []
    for sink, label in CHANNELS:
        rows += [sink, label]
    rows += [apps.IGNORE, "Leave on Default (stop asking)"]
    try:
        r = subprocess.run(
            ["zenity", "--list", "--title", f"Route: {display}",
             "--text", f"<b>{display}</b> started playing.\nWhich channel should it use?",
             "--column", "sink", "--column", "Channel", "--hide-column=1",
             *rows, "--width", "360", "--height", "320"],
            capture_output=True, text=True, timeout=120,
        )
    except Exception:
        return None
    if r.returncode != 0:
        return None
    choice = r.stdout.strip().rstrip("|")
    return choice or None


def stream_props(stream):
    return {"application.process.binary": stream["binary"], "application.name": stream["app"],
            "node.name": stream["node"]}


def assign(stream, choice):
    """Persist the choice and make it take effect now (no audio blip)."""
    apps.remember(stream_props(stream), choice)
    if choice != apps.IGNORE:
        # Move the live stream right now for instant feedback (it's currently on
        # the catch-all channel, so this is never a loud jump), and recompile the
        # rules so it's born there next time.
        apps.route_now([stream["idx"]], choice)


# The mixer window lists new apps itself ("new" marker), so while it runs the
# popup would ask the same question twice.
WINDOW_ID = "io.github.crazygogo42.AudioMixer"


def window_running():
    out = run(["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
               "--object-path", "/org/freedesktop/DBus",
               "--method", "org.freedesktop.DBus.NameHasOwner", WINDOW_ID])
    return "true" in out


def should_prompt(window_is_running):
    return not window_is_running


# --------------------------------------------------------------------------- #
# Patchbay
# --------------------------------------------------------------------------- #

def skip_stream(node_name, own):
    """Our own nodes are plumbing, never an app to ask about."""
    return node_name in own


# (channel sink -> node id, mixer.json mtime) last used to apply Bass/Treble.
eq_seen = None
# The poll thread and the event loop both run passes; never interleave them.
patch_lock = threading.Lock()


def event_rewires(line):
    """Does this `pactl subscribe` line call for a patchbay pass? A device,
    EasyEffects or one of our nodes coming or going, or the default output
    changing ("Default output" slots follow it). Not clients (every pactl run),
    meters (source-outputs) or plain volume changes."""
    if " on server" in line:
        return "'change'" in line
    is_device = " on sink " in line + " " or " on source " in line + " "
    return is_device and ("'new'" in line or "'remove'" in line)


def tick(graph=None):
    """One daemon pass: volumes first, then links. Nodes that were just
    (re)created come up at 100%, so their saved levels must be back before
    anything links them — otherwise an unplanned PipeWire restart would play
    them at full volume."""
    with patch_lock:
        graph = graph if graph is not None else read_graph()
        volume_tick(graph)
        _patch(graph)


def _patch(graph):
    """Relink whatever drifted, and re-apply Bass/Treble when the channel nodes
    are new (PipeWire restarted) or mixer.json changed. Idempotent."""
    global eq_seen
    if not graph.nodes:
        return  # PipeWire not reachable right now
    try:
        reconcile_once(graph)
    except Exception:
        pass
    try:
        mtime = os.path.getmtime(STATE_FILE)
    except OSError:
        mtime = None
    seen = ({c.sink: graph.nodes[c.sink].id for c in CHANNEL_LIST if c.sink in graph.nodes}, mtime)
    if seen != eq_seen:
        apply_eq(graph, CHANNEL_LIST, load_state(CHANNEL_LIST))
        eq_seen = seen


# --------------------------------------------------------------------------- #
# Volume persistence (channels, the EasyEffects strip, Mic_In, All Audio)
# --------------------------------------------------------------------------- #

def volume_targets(channels):
    """[(node name, "sink" | "source")] whose volume survives reboots."""
    return ([(c.sink, "sink") for c in channels]
            + [(EE_RETURN, "sink"), (MIC_IN, "source"), (ALL_AUDIO, "source")])


VOLUME_TARGETS = volume_targets(CHANNEL_LIST)


def snapshot_volumes():
    """{node: raw_volume} for every volume target currently present — one
    `pactl -f json list` per kind instead of one pactl per node."""
    kinds = {kind for _, kind in VOLUME_TARGETS}
    raw, muted = {}, {}
    for kind in kinds:
        try:
            entries = json.loads(run(["pactl", "-f", "json", "list", kind + "s"]) or "[]")
        except ValueError:
            entries = []
        for e in entries if isinstance(entries, list) else []:
            try:
                raw[(e["name"], kind)] = int(next(iter(e["volume"].values()))["value"])
                muted[(e["name"], kind)] = bool(e.get("mute"))
            except (KeyError, TypeError, ValueError, StopIteration):
                pass
    vols = {name: raw[(name, kind)] for name, kind in VOLUME_TARGETS if (name, kind) in raw}
    if vols:
        # Mutes survive reboots too: a muted mic must come back muted.
        vols["_mute"] = {name: muted[(name, kind)] for name, kind in VOLUME_TARGETS if (name, kind) in muted}
    return vols


def save_volumes():
    """Persist current volumes — only a complete, changed snapshot."""
    vols = snapshot_volumes()
    if not vols or len(vols) - ("_mute" in vols) < len(VOLUME_TARGETS):
        return  # not all up yet; never persist a partial snapshot
    try:
        with open(VOL_FILE) as f:
            if json.load(f) == vols:
                return  # unchanged, skip the write
    except Exception:
        pass
    os.makedirs(os.path.dirname(VOL_FILE), exist_ok=True)
    tmp = VOL_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(vols, f, indent=2)
    os.replace(tmp, VOL_FILE)


def restore_volumes(path=None, targets=None, names=None):
    """Re-apply the saved volumes (no-op on first ever run); only `names` if given."""
    kinds = dict(VOLUME_TARGETS if targets is None else targets)
    try:
        with open(path or VOL_FILE) as f:
            vols = json.load(f)
    except Exception:
        return
    # Mutes are put back, never taken off: nodes come up unmuted anyway, and a
    # late second pass must not undo a mute you made in between.
    mutes = vols.get("_mute") if isinstance(vols.get("_mute"), dict) else {}  # older files have none
    for name, raw in vols.items():
        if name in kinds and (names is None or name in names):
            subprocess.run(["pactl", f"set-{kinds[name]}-volume", name, str(int(raw))],
                           capture_output=True, text=True)
            if mutes.get(name) is True:
                subprocess.run(["pactl", f"set-{kinds[name]}-mute", name, "1"],
                               capture_output=True, text=True)


def volume_tick(graph):
    """One volume pass. Any target that was just (re)created — login, a
    PipeWire or EasyEffects restart — gets its saved level re-applied on this
    pass and the next (to win against WirePlumber's own restore) instead of
    having its fresh 100% saved. Once nothing is pending and every target
    exists, changes are saved."""
    ids = {name: graph.nodes[name].id for name, _ in VOLUME_TARGETS if name in graph.nodes}
    for name, nid in ids.items():
        if vol_ids_seen.get(name) != nid:
            vol_ids_seen[name] = nid
            restores_left[name] = 2
    due = {name for name in ids if restores_left.get(name)}
    if due:
        restore_volumes(names=due)
        for name in due:
            restores_left[name] -= 1
    elif len(ids) == len(VOLUME_TARGETS):
        save_volumes()


def wait_for_channels(timeout=30):
    """Block until all virtual sinks exist (or timeout)."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if VIRTUAL_SINKS.issubset(set(sink_index_to_name().values())):
            return True
        time.sleep(0.5)
    return False


# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

def kill_previous():
    try:
        with open(PID_FILE) as f:
            old = int(f.read().strip())
        # After a reboot the stale PID may belong to some unrelated process.
        with open(f"/proc/{old}/cmdline", "rb") as f:
            is_daemon = b"audio-router-daemon" in f.read()
        if old != os.getpid() and is_daemon:
            os.kill(old, signal.SIGTERM)
            time.sleep(0.3)
    except Exception:
        pass


def cleanup(*_):
    # Save the latest levels and mutes (the poll may be up to 10 s behind,
    # e.g. a mic muted just before reboot) — unless a restore is still
    # pending, when the nodes would still be at their fresh 100%.
    if vol_ids_seen and not any(restores_left.values()):
        try:
            save_volumes()
        except Exception:
            pass
    try:
        os.unlink(PID_FILE)
    except OSError:
        pass
    sys.exit(0)


BIN_DIR = os.path.expanduser("~/.local/bin")


def heal_hotkeys():
    """The window takes our GNOME shortcuts out while you press a new
    combination; if it died before putting them back, put them back. Costs one
    file check per pass otherwise."""
    if hotkeys.suspended() and not window_running():
        hotkeys.heal(CHANNEL_LIST, BIN_DIR)


def consider(stream, routes):
    binary, app = stream["binary"], stream["app"]
    if skip_stream(stream["node"], OWN):
        return
    if app in apps.IGNORE_APPS or binary in apps.IGNORE_APPS:
        return
    display = app or binary or stream["node"]
    if not display or display.startswith("PipeWire"):
        return
    if apps.is_known(routes, stream_props(stream)):
        return
    if app in asked_this_session or binary in asked_this_session:
        return
    if not should_prompt(window_running()):
        return
    asked_this_session.add(app or binary)
    asked_this_session.add(binary or app)
    choice = ask_channel(display)
    if choice:
        assign(stream, choice)


def main():
    kill_previous()
    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    time.sleep(2)  # let PipeWire settle on login

    # Saved volumes go back as soon as the channels exist (volume_tick restores
    # on this pass and the next, then starts saving changes; it does the same
    # after every PipeWire restart).
    wait_for_channels()
    tick()

    # Keep the mixer wired even when EasyEffects or a device comes and goes.
    # tick() is idempotent (it only touches links that drifted), so polling it
    # is quiet and self-healing, and it sidesteps the timing races of reacting
    # to individual graph events. The same poll snapshots volumes so the latest
    # levels survive the next reboot.
    def chain_watch():
        while True:
            time.sleep(CHAIN_POLL_SECONDS)
            try:
                tick()
            except Exception:
                pass
            try:
                heal_hotkeys()
            except Exception:
                pass
    threading.Thread(target=chain_watch, daemon=True).start()

    # Outer loop keeps us alive across pipewire-pulse restarts: `pactl subscribe`
    # ends when pulse restarts, so we re-settle, re-wire the chain, rescan, and
    # resubscribe instead of dying.
    while True:
        tick()
        routes = apps.load_routes()
        for stream in list_streams():
            consider(stream, routes)

        proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
        for line in proc.stdout:
            if "'new'" in line and " on sink-input" in line:
                time.sleep(0.3)  # let props populate; stream is already safe on Default
                routes = apps.load_routes()
                for stream in list_streams():
                    consider(stream, routes)
            elif event_rewires(line):
                time.sleep(0.5)
                tick()

        # Subscription ended — pulse restarted or crashed. Reconnect after a beat.
        try:
            proc.wait(timeout=2)
        except Exception:
            pass
        time.sleep(1.5)


if __name__ == "__main__":
    main()
