#!/usr/bin/env python3
"""
Compile the mixer config into PipeWire config and apply it.

This is the heart of the mixer: instead of a daemon chasing streams around
*after* they appear, we tell pipewire-pulse where every app belongs *before*
its stream is created. Each app is born on the right virtual sink — no race,
no window where audio escapes to the hardware at full volume.

    channels.conf + mixer.json ──►  virtual-sinks.conf           ──► pipewire
    routes.json                ──►  50-audio-mixer-routing.conf  ──► pipewire-pulse

The nodes themselves are described in audiomixer/render.py; where they're
linked is the daemon's job (audiomixer/reconcile.py).

Run with no arguments to regenerate both and restart pipewire-pulse. PipeWire
itself is restarted only when the set of nodes changed (that briefly drops all
audio and takes EasyEffects down, so we bring EasyEffects back up after); a
Bass/Treble change alone never needs it. Pass --no-restart to only write the
files (caller restarts later), or --restart-pipewire to force the full
restart — the fix if a channel goes silent.
"""

import json
import os
import subprocess
import sys
import tempfile
import time

# The shared audiomixer package: lib/ next to bin/ in the repo, or installed.
for _lib in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
             os.path.expanduser("~/.local/lib/audio-mixer")):
    if os.path.isdir(os.path.join(_lib, "audiomixer")):
        sys.path.insert(0, _lib)
        break
from audiomixer import easyeffects  # noqa: E402
from audiomixer.config import (  # noqa: E402
    CHANNELS_FILE, EE_SINK, catch_all, load_channels, load_state,
)
from audiomixer.pwgraph import read_graph  # noqa: E402
from audiomixer.reconcile import plan_changes, reconcile_once  # noqa: E402
from audiomixer.render import needs_restart, render_routes, render_sinks  # noqa: E402
from audiomixer.routing import desired_links, managed_nodes  # noqa: E402

ROUTES_FILE = os.path.expanduser("~/.config/audio-mixer/routes.json")
SINKS_FILE = os.path.expanduser("~/.config/pipewire/pipewire.conf.d/virtual-sinks.conf")
OUT_FILE = os.path.expanduser(
    "~/.config/pipewire/pipewire-pulse.conf.d/50-audio-mixer-routing.conf"
)
# pipewire-pulse property names for each match field in routes.json
FIELD_PROP = {
    "binary": "application.process.binary",
    "app": "application.name",
}


def load_routes(valid_sinks, default_sink):
    with open(ROUTES_FILE) as f:
        data = json.load(f)
    # channel -> list of (property_name, value)
    by_channel = {}
    for field, prop in FIELD_PROP.items():
        for value, channel in (data.get(field) or {}).items():
            if channel not in valid_sinks or channel == default_sink:
                continue
            by_channel.setdefault(channel, []).append((prop, value))
    return by_channel


def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def write_atomic(path, text):
    """Write text to path unless it already holds exactly that."""
    if read_text(path) == text:
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def systemctl(*args):
    subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


def wiring_problems(channels):
    """What's still not wired as wanted, as short readable lines."""
    graph = read_graph()
    state = load_state(channels)
    if any(state.channels[c.key].fx for c in channels) and EE_SINK not in graph.nodes:
        return ["EasyEffects isn't running yet; FX channels stay silent until it starts"]
    missing, _ = plan_changes(desired_links(channels, state, graph), graph, managed_nodes(channels))
    return sorted({f"{out.split(':')[0]} -> {inp.split(':')[0]}" for out, inp in missing})


def restart_pipewire(channels):
    """Restart the whole PipeWire stack so new/removed nodes take effect.

    Restarting PipeWire kills EasyEffects and leaves a stale single-instance
    lock that makes the next launch silently exit. So quit EasyEffects cleanly
    first (-q also flushes its settings to disk), then relaunch it afterwards.

    Always restart all three services together. Restarting WirePlumber alone
    drops every link in the graph and nothing gets relinked (PipeWire 1.0 /
    WirePlumber 0.4)."""
    ee_was_running = easyeffects.is_running()
    if ee_was_running:
        easyeffects.quit()
    systemctl("restart", "pipewire", "pipewire-pulse", "wireplumber")
    # Give the nodes time to settle before EasyEffects' sink appears. With the
    # old WirePlumber-linked channels, relaunching after only 2s once left a
    # channel's output in an error state with no links; waiting 8s avoided it.
    time.sleep(8)
    if ee_was_running:
        easyeffects.launch()
    # Wire everything now rather than waiting for the daemon's next pass, then
    # say so if something didn't make it, rather than leaving it silently dead.
    deadline = time.time() + 15
    while True:
        reconcile_once()
        problems = wiring_problems(channels)
        if not problems or time.time() > deadline:
            break
        time.sleep(1)
    if problems:
        print("Not wired yet:\n  " + "\n  ".join(problems)
              + "\nRun `audio-routes-apply --restart-pipewire` to retry.", file=sys.stderr)
    # The daemon reads the channel list at startup.
    systemctl("try-restart", "audio-router-daemon.service")


def main():
    for path in (CHANNELS_FILE, ROUTES_FILE):
        if not os.path.isfile(path):
            print(f"not found: {path}", file=sys.stderr)
            return 1
    channels = load_channels()
    try:
        default_sink = catch_all(channels).sink
    except ValueError as e:
        print(f"{CHANNELS_FILE}: {e}", file=sys.stderr)
        return 1
    sinks = render_sinks(channels, load_state(channels))
    restart = needs_restart(read_text(SINKS_FILE), sinks)
    write_atomic(SINKS_FILE, sinks)
    by_channel = load_routes({c.sink for c in channels}, default_sink)
    write_atomic(OUT_FILE, render_routes(by_channel, default_sink))
    if "--no-restart" not in sys.argv:
        if restart or "--restart-pipewire" in sys.argv:
            restart_pipewire(channels)
        else:
            systemctl("restart", "pipewire-pulse.service")
    return 0


if __name__ == "__main__":
    sys.exit(main())
