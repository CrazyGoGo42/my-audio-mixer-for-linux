#!/usr/bin/env python3
"""
Compile the mixer config into PipeWire config and apply it.

This is the heart of the mixer: instead of a daemon chasing streams around
*after* they appear, we tell pipewire-pulse where every app belongs *before*
its stream is created. Each app is born on the right virtual sink — no race,
no window where audio escapes to the hardware at full volume.

    channels.conf  ──(this script)──►  virtual-sinks.conf (+ All Audio) ──► pipewire
    routes.json    ──(this script)──►  50-audio-mixer-routing.conf  ──► pipewire-pulse

Run with no arguments to regenerate both and restart pipewire-pulse. PipeWire
itself is restarted only when the channel list changed (that briefly drops all
audio and takes EasyEffects down, so we bring EasyEffects back up after). Pass
--no-restart to only write the files (caller restarts later), or
--restart-pipewire to force the full restart — the fix if a channel goes silent.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

# The shared audiomixer package: lib/ next to bin/ in the repo, or installed.
for _lib in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
             os.path.expanduser("~/.local/lib/audio-mixer")):
    if os.path.isdir(os.path.join(_lib, "audiomixer")):
        sys.path.insert(0, _lib)
        break
from audiomixer.config import CHANNELS_FILE, catch_all, load_channels  # noqa: E402

ROUTES_FILE = os.path.expanduser("~/.config/audio-mixer/routes.json")
SINKS_FILE = os.path.expanduser("~/.config/pipewire/pipewire.conf.d/virtual-sinks.conf")
OUT_FILE = os.path.expanduser(
    "~/.config/pipewire/pipewire-pulse.conf.d/50-audio-mixer-routing.conf"
)
EE_APP = "com.github.wwmm.easyeffects"
ALL_SOURCE = "All_Audio"  # the all-channels-in-one input
# pipewire-pulse property names for each match field in routes.json
FIELD_PROP = {
    "binary": "application.process.binary",
    "app": "application.name",
}


def spa_quote(s):
    """Quote a string for a PipeWire SPA-JSON config value."""
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def load_routes(valid_sinks, default_sink):
    with open(ROUTES_FILE) as f:
        data = json.load(f)
    # channel -> list of (property_name, value)
    by_channel = {}
    for field, prop in FIELD_PROP.items():
        for value, channel in (data.get(field) or {}).items():
            if channel not in valid_sinks or channel == default_sink:
                continue
            by_channel.setdefault(channel, []).append((prop, value))
    return by_channel


def easyeffects_installed():
    if shutil.which("easyeffects"):
        return True
    try:
        return subprocess.run(["flatpak", "info", EE_APP],
                              capture_output=True).returncode == 0
    except OSError:
        return False


def render_sinks(channels):
    # With EasyEffects installed, pin every channel to its sink by name. That
    # name never changes, unlike hardware sink names (switching the speakers to
    # 4.0 renames "…analog-stereo" to "…analog-surround-40"), and it's right even
    # when EasyEffects isn't running yet at install time. Without EasyEffects,
    # leave the target unset so the channels follow the default output device
    # (and move to a headset when you plug one in).
    downstream = "easyeffects_sink" if easyeffects_installed() else None
    target = f" target.object = {spa_quote(downstream)}" if downstream else ""
    lines = [
        "# Generated by audio-routes-apply from ~/.config/audio-mixer/channels.conf",
        "# — do not edit by hand; edit channels.conf and rerun audio-routes-apply.",
        "#",
        "# One PipeWire loopback sink per channel. Per-channel volume lives on the",
        "# sink that apps connect to; its \"_out\" side feeds "
        + (downstream or "the default output") + ":",
        "#",
        "#     App -> <Channel>_Audio (volume) -> "
        + (downstream or "default output") + " -> hardware",
        "#",
        "# NOTE: each *.props block stays on a single line. The SPA config parser in",
        "# PipeWire 1.0.x silently drops later modules if a props block is split",
        "# across lines.",
        "",
        "context.modules = [",
    ]
    for ch in channels:
        sink, label = ch.sink, ch.label
        lines += [
            "    {   name = libpipewire-module-loopback",
            "        args = {",
            f"            node.description = {spa_quote(label + ' Audio')}",
            f"            capture.props = {{ node.name = {spa_quote(sink)}"
            ' media.class = "Audio/Sink" audio.position = [ FL FR ] }',
            f"            playback.props = {{ node.name = {spa_quote(sink + '_out')}"
            f" node.passive = true{target} }}",
            "        }",
            "    }",
        ]
    # "All Audio": every channel mixed together, offered to apps as an input
    # (pick it like a microphone in OBS, a recorder, ...). It listens to the sink
    # the channels feed, so it carries each channel at the level and mute you set,
    # before EasyEffects' effects. The mic isn't in it. Passive capture: it costs
    # nothing until something records from it.
    lines += [
        "    # All Audio — every channel mixed, as an input for recording/streaming",
        "    {   name = libpipewire-module-loopback",
        "        args = {",
        f"            node.description = {spa_quote('All Audio')}",
        f"            capture.props = {{ node.name = {spa_quote(ALL_SOURCE + '_in')}"
        f" stream.capture.sink = true node.passive = true{target}"
        " audio.position = [ FL FR ] }",
        f"            playback.props = {{ node.name = {spa_quote(ALL_SOURCE)}"
        ' media.class = "Audio/Source" audio.position = [ FL FR ] }',
        "        }",
        "    }",
    ]
    lines.append("]")
    lines.append("")
    return "\n".join(lines)


def render(by_channel, default_sink):
    lines = [
        "# Generated by audio-routes-apply — do not edit by hand.",
        "# Edit ~/.config/audio-mixer/routes.json and rerun audio-routes-apply.",
        "#",
        "# How this works: the first rule is a catch-all that sends EVERY app to the",
        "# Default channel (attenuated and safe). Later rules are more specific and",
        "# override it, pulling known apps onto their own channel. Because the target",
        "# is set at stream creation, an app is born on the right sink every time --",
        "# no race, and nothing ever escapes to the hardware at full volume.",
        "",
        "pulse.rules = [",
        "    # Catch-all: anything with an app name or binary -> Default.",
        "    {",
        "        matches = [",
        '            { application.name = "~.+" }',
        '            { application.process.binary = "~.+" }',
        "        ]",
        f"        actions = {{ update-props = {{ target.object = {spa_quote(default_sink)} }} }}",
        "    }",
    ]
    for channel in sorted(by_channel):
        matches = by_channel[channel]
        lines.append("    {")
        lines.append("        matches = [")
        for prop, value in matches:
            lines.append(f"            {{ {prop} = {spa_quote(value)} }}")
        lines.append("        ]")
        lines.append(
            f"        actions = {{ update-props = {{ target.object = {spa_quote(channel)} }} }}"
        )
        lines.append("    }")
    lines.append("]")
    lines.append("")
    return "\n".join(lines)


def write_atomic(path, text):
    """Write text to path; return True if the content changed."""
    try:
        with open(path) as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return True


def systemctl(*args):
    subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


def easyeffects_running():
    return subprocess.run(["pgrep", "-f", "easyeffects --service-mode"],
                          capture_output=True).returncode == 0


def restart_pipewire(sinks):
    """Restart the whole PipeWire stack so new/removed channels take effect.

    Restarting PipeWire kills EasyEffects and leaves a stale single-instance
    lock that makes the next launch silently exit. So quit EasyEffects cleanly
    first (-q also flushes its settings to disk), then relaunch it afterwards.

    Always restart all three services together. Restarting WirePlumber alone
    drops every link in the graph and nothing gets relinked (PipeWire 1.0 /
    WirePlumber 0.4)."""
    ee_was_running = easyeffects_running()
    if ee_was_running:
        try:
            subprocess.run(["flatpak", "run", EE_APP, "-q"],
                           capture_output=True, timeout=10)
        except Exception:
            subprocess.run(["pkill", "-f", "easyeffects --service-mode"],
                           capture_output=True)
    systemctl("restart", "pipewire", "pipewire-pulse", "wireplumber")
    # Give the channels time to settle before EasyEffects' sink appears and
    # WirePlumber moves them onto it. Relaunching after only 2s once left a
    # channel's output in an error state with no links at all (silent channel);
    # waiting 8s avoided it.
    time.sleep(8)
    if ee_was_running:
        lockdir = f"/run/user/{os.getuid()}/.flatpak/{EE_APP}/tmp"
        for name in ("EasyEffectsServer", "easyeffects.lock"):
            try:
                os.unlink(os.path.join(lockdir, name))
            except OSError:
                pass
        subprocess.Popen(["flatpak", "run", EE_APP, "--service-mode", "--hide-window"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        # Say so if a channel didn't make it onto EasyEffects, rather than
        # leaving it silently dead.
        deadline = time.time() + 15
        while (missing := unlinked_channels(sinks, "easyeffects_sink")) and time.time() < deadline:
            time.sleep(1)
        if missing:
            print("Not connected to EasyEffects: " + ", ".join(missing)
                  + "\nRun `audio-routes-apply --restart-pipewire` to retry.",
                  file=sys.stderr)
    # The daemon reads the channel list at startup.
    systemctl("try-restart", "audio-router-daemon.service")


def unlinked_channels(sinks, target):
    """Channel sinks whose "_out" side has no link to target."""
    out = subprocess.run(["pw-link", "-l"], capture_output=True, text=True).stdout
    linked, port_node = set(), None
    for line in out.splitlines():
        if not line.startswith(" "):
            port_node = line.split(":", 1)[0]
        elif line.split("|->", 1)[-1].strip().startswith(target + ":"):
            linked.add(port_node)
    return [s for s in sinks if s + "_out" not in linked]


def main():
    for path in (CHANNELS_FILE, ROUTES_FILE):
        if not os.path.isfile(path):
            print(f"not found: {path}", file=sys.stderr)
            return 1
    channels = load_channels()
    try:
        default_sink = catch_all(channels).sink
    except ValueError as e:
        print(f"{CHANNELS_FILE}: {e}", file=sys.stderr)
        return 1
    sinks_changed = write_atomic(SINKS_FILE, render_sinks(channels))
    by_channel = load_routes({c.sink for c in channels}, default_sink)
    write_atomic(OUT_FILE, render(by_channel, default_sink))
    if "--no-restart" not in sys.argv:
        if sinks_changed or "--restart-pipewire" in sys.argv:
            restart_pipewire([c.sink for c in channels])
        else:
            systemctl("restart", "pipewire-pulse.service")
    return 0


if __name__ == "__main__":
    sys.exit(main())
