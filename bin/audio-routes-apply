#!/usr/bin/env python3
"""
Compile routes.json into a pipewire-pulse routing config and apply it.

This is the heart of the mixer: instead of a daemon chasing streams around
*after* they appear, we tell pipewire-pulse where every app belongs *before*
its stream is created. Each app is born on the right virtual sink — no race,
no window where audio escapes to the hardware at full volume.

    routes.json  ──(this script)──►  50-audio-mixer-routing.conf  ──► pipewire-pulse

Run with no arguments to regenerate and restart pipewire-pulse. Pass
--no-restart to only write the file (caller restarts later).
"""

import json
import os
import subprocess
import sys
import tempfile

ROUTES_FILE = os.path.expanduser("~/.config/audio-mixer/routes.json")
OUT_FILE = os.path.expanduser(
    "~/.config/pipewire/pipewire-pulse.conf.d/50-audio-mixer-routing.conf"
)
DEFAULT_SINK = "Default_Audio"
VALID_SINKS = {
    "Games_Audio", "Discord_Audio", "Music_Audio", "Browser_Audio", "Default_Audio",
}
# pipewire-pulse property names for each match field in routes.json
FIELD_PROP = {
    "binary": "application.process.binary",
    "app": "application.name",
}


def spa_quote(s):
    """Quote a string for a PipeWire SPA-JSON config value."""
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def load_routes():
    with open(ROUTES_FILE) as f:
        data = json.load(f)
    # channel -> list of (property_name, value)
    by_channel = {}
    for field, prop in FIELD_PROP.items():
        for value, channel in (data.get(field) or {}).items():
            if channel not in VALID_SINKS or channel == DEFAULT_SINK:
                continue
            by_channel.setdefault(channel, []).append((prop, value))
    return by_channel


def render(by_channel):
    lines = [
        "# Generated by audio-routes-apply — do not edit by hand.",
        "# Edit ~/.config/audio-mixer/routes.json and rerun audio-routes-apply.",
        "#",
        "# How this works: the first rule is a catch-all that sends EVERY app to the",
        "# Default channel (attenuated and safe). Later rules are more specific and",
        "# override it, pulling known apps onto their own channel. Because the target",
        "# is set at stream creation, an app is born on the right sink every time --",
        "# no race, and nothing ever escapes to the hardware at full volume.",
        "",
        "pulse.rules = [",
        "    # Catch-all: anything with an app name or binary -> Default.",
        "    {",
        "        matches = [",
        '            { application.name = "~.+" }',
        '            { application.process.binary = "~.+" }',
        "        ]",
        f"        actions = {{ update-props = {{ target.object = {spa_quote(DEFAULT_SINK)} }} }}",
        "    }",
    ]
    for channel in sorted(by_channel):
        matches = by_channel[channel]
        lines.append("    {")
        lines.append("        matches = [")
        for prop, value in matches:
            lines.append(f"            {{ {prop} = {spa_quote(value)} }}")
        lines.append("        ]")
        lines.append(
            f"        actions = {{ update-props = {{ target.object = {spa_quote(channel)} }} }}"
        )
        lines.append("    }")
    lines.append("]")
    lines.append("")
    return "\n".join(lines)


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def restart_pulse():
    subprocess.run(
        ["systemctl", "--user", "restart", "pipewire-pulse.service"],
        capture_output=True, text=True,
    )


def main():
    if not os.path.isfile(ROUTES_FILE):
        print(f"routes file not found: {ROUTES_FILE}", file=sys.stderr)
        return 1
    by_channel = load_routes()
    write_atomic(OUT_FILE, render(by_channel))
    if "--no-restart" not in sys.argv:
        restart_pulse()
    return 0


if __name__ == "__main__":
    sys.exit(main())
