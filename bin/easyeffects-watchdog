#!/bin/bash
# Keeps the EasyEffects service alive. It dies or hangs when PipeWire devices
# vanish/re-enumerate, and a dead/hung primary + leftover lock makes every
# later launch silently exit. Two failure modes handled:
#   1. no service process        -> start it
#   2. process up but CLI hangs  -> kill it, clear stale lock/socket, restart
APP=com.github.wwmm.easyeffects
LOCKDIR="/run/user/$(id -u)/.flatpak/$APP/tmp"
INTERVAL=60
PROBE_TIMEOUT=20
FAILS=0

log() { echo "[easyeffects-watchdog] $*"; }

start_service() {
    rm -f "$LOCKDIR/EasyEffectsServer" "$LOCKDIR/easyeffects.lock"
    setsid -f flatpak run "$APP" --service-mode --hide-window >/dev/null 2>&1
}

recover() {
    log "$1 - restarting"
    timeout 10 flatpak kill "$APP" >/dev/null 2>&1
    pkill -f 'easyeffects --service-mode' 2>/dev/null
    sleep 2
    start_service
    FAILS=0
}

sleep 30   # let the session, PipeWire and EE's own autostart settle
while true; do
    if ! pgrep -f 'easyeffects --service-mode' >/dev/null; then
        recover "service not running"
    elif timeout "$PROBE_TIMEOUT" flatpak run "$APP" -a input >/dev/null 2>&1; then
        FAILS=0
    else
        FAILS=$((FAILS + 1))
        log "probe failed ($FAILS/2)"
        [ "$FAILS" -ge 2 ] && recover "service unresponsive"
    fi
    sleep "$INTERVAL"
done
